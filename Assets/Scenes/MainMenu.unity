    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\uC804\uD22C</b>\n\uC774\uB3D9  WASD\n\uC870\uC900  \uB9C8\uC6B0\uC2A4\n\uC0AC\uACA9 
    \uB9C8\uC6B0\uC2A4 \uC67C\uCABD\n\uB300\uC2DC  Space\n\uC7AC\uC7A5\uC804  R\n\uBB34\uAE30
    \uAD50\uCCB4  E\n\uC218\uB958\uD0C4  G\n\n<b>\uC815\uBE44</b>\n\uC544\uC774\uD15C
    \uC9D1\uAE30\xB7\uB193\uAE30  \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uD074\uB9AD\n\uBAA8\uB4C8
    \uD68C\uC804  R\n\uB4E4\uACE0 \uC788\uB294 \uC544\uC774\uD15C \uB418\uB3CC\uB9AC\uAE30 
    \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD\n\uC0C1\uC138 \uC815\uBCF4  \uC544\uC774\uD15C
    \uC704\uC5D0 \uB9C8\uC6B0\uC2A4 \uC62C\uB9AC\uAE30\n\n<b>\uBAA9\uD45C</b>\n\uAD34\uBB3C\uC774
    \uCE68\uC785\uD55C \uC9C0\uD558 \uC2DC\uC124(DEPTH 15)\uC5D0\uC11C \uD55C \uCE35\uC529
    \uC62C\uB77C\uAC00 \uC9C0\uC0C1(DEPTH 0)\uC5D0 \uB3C4\uB2EC\uD558\uC138\uC694.\n\uAC01
    \uCE35\uC758 \uD0C8\uCD9C \uAD6C\uC5ED\uC5D0\uC11C \uBC84\uD2F0\uBA74 \uB2E4\uC74C
    \uCE35\uC73C\uB85C \uC62C\uB77C\uAC11\uB2C8\uB2E4. \uC815\uBE44 \uC2DC\uAC04\uC5D0\uB294
    \uADF8\uB9AC\uB4DC\uC5D0 \uBAA8\uB4C8\uC744 \uBC30\uCE58\uD574 \uBB34\uAE30\uB97C
    \uAC15\uD654\uD558\uC138\uC694.\n\uC9C0\uC0C1\uC5D0 \uAC00\uAE4C\uC6CC\uC9C8\uC218\uB85D
    \uB354 \uB9CE\uC740 \uC801\uC744 \uC0C1\uB300\uD574\uC57C \uD560 \uAC83\uC785\uB2C8\uB2E4."
